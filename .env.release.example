# Release signing + notarization config for scripts/release.sh.
# Copy to .env.release (gitignored) and fill in. None of these are committed.

# The Developer ID Application identity to sign with. Not a secret — it's just
# the certificate's name as shown by: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Pedro Schapira (CCMY5ZR77Q)"

# Notarization credentials. Provide EITHER an App Store Connect API key…
# APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
# APPLE_API_KEY="XXXXXXXXXX"
# APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"

# …OR an Apple ID with an app-specific password (appleid.apple.com → Sign-In
# and Security → App-Specific Passwords):
# APPLE_ID="you@example.com"
# APPLE_PASSWORD="abcd-efgh-ijkl-mnop"
# APPLE_TEAM_ID="CCMY5ZR77Q"
